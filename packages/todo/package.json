{
  "name": "@zle13/pi-todo",
  "version": "0.2.0",
  "description": "A visible todo list for Pi: session-scoped task tracking, /todos control surface, and a collapsible live overlay.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "todo",
    "tasks"
  ],
  "author": "zle13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeZH13/zle-pi.git",
    "directory": "packages/todo"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  }
}
