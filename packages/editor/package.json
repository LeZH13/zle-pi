{
  "name": "@zle13/pi-editor",
  "version": "0.4.0",
  "description": "A Vim-style Pi prompt editor with a session-name badge and a shell-command clipboard picker.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "editor",
    "session"
  ],
  "author": "zle13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeZH13/zle-pi.git",
    "directory": "packages/editor"
  },
  "files": [
    "extensions",
    "lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "marked": "^18.0.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/editor.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  }
}
